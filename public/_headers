# Regra de assets do vinext (replicada aqui: o public/_headers substitui o arquivo
# gerado pelo build — manter em sincronia com o "generated by vinext" do build output)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Engine assets: COOP/COEP/CORP + cache imutável (o next.config headers() não se aplica
# a assets estáticos no Workers; o worker de engine exige CORP sob COEP — blockedReason
# coep-frame-resource-needs-coep-header — e o wasm é content-versioned).
/engine/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable
