NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public base URL used for auth email redirects (signup confirmation, password reset).
# REQUIRED in production (must be a well-formed https: URL, e.g. https://your-app.example).
# In development/testing, falls back to the request Origin header or http://localhost:3000 if unset.
# Note: NEXT_PUBLIC_* variables are inlined at build time; ensure it is set in your build environment.
# NEXT_PUBLIC_SITE_URL=https://your-app.example
# Fallback alias still read by the client:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same project, read by @supabase/server. The browser only sees NEXT_PUBLIC_*.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix with NEXT_PUBLIC.
# Required to publish courses. The signed-in admin is still checked first.
# SUPABASE_SECRET_KEY=

# Server-only. Comma-separated emails that may create courses.
# The same emails can live in public.course_admins. Student accounts cannot publish.
# In the Supabase Dashboard under Authentication -> Providers -> Email, "Confirm email"
# must be ON so unconfirmed signups cannot claim admin privileges.
# COURSE_ADMINS=
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional. Lichess opening explorer now often requires a personal token
# (lichess.org/account/oauth/token, no scopes needed). Without it the app
# falls back to a built-in master sample book.
# LICHESS_TOKEN=
